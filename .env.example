# =============================================================================
# AlgoFile Backend — environment variables
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3001
# `development` enables dev-only routes such as GET /api/auth/dev-login.
# Use `production` on any public deployment.
NODE_ENV=development
# Public base URL of THIS API (no trailing slash, no `/api`).
# Used to build absolute x402 resource URLs indexed by the facilitator / Bazaar.
# Must be a publicly reachable HTTPS URL in production.
BACKEND_URL=http://localhost:3001
# Frontend URL used for OAuth redirects
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/algofile

# -----------------------------------------------------------------------------
# Auth (JWT + Google OAuth)
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=7d

# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# 32-byte key as 64 hex chars (REQUIRED — the app refuses to start without it).
# Used to encrypt sensitive per-user data at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Algorand / x402 payments
# -----------------------------------------------------------------------------
# `testnet` or `mainnet`. Selects the CAIP-2 network id and the USDC ASA
# (testnet USDC = 10458941, mainnet USDC = 31566704).
ALGORAND_NETWORK=testnet
# Algorand address that receives x402 payments (`payTo`).
# The account must be opted in to the USDC ASA on the selected network.
ALGORAND_RECEIVER_WALLET=
# Alias accepted by the x402 service (falls back to ALGORAND_RECEIVER_WALLET)
# AVM_ADDRESS=

# x402 facilitator that verifies and settles payments on Algorand.
FACILITATOR_URL=https://facilitator.goplausible.xyz
# Optional: gasless fee payer address. If empty it is discovered automatically
# from `${FACILITATOR_URL}/supported` at startup.
# FACILITATOR_FEE_PAYER=

# -----------------------------------------------------------------------------
# Filebase (S3-compatible API + IPFS pinning)
# Get credentials at https://console.filebase.com/keys
# -----------------------------------------------------------------------------
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=

# IPFS RPC API (pinning service)
FILEBASE_IPFS_RPC_ENDPOINT=https://rpc.filebase.io
# Default IPFS RPC token (fallback when a bucket has no token of its own)
FILEBASE_IPFS_RPC_TOKEN=

# Comma-separated dedicated gateway hostnames (no protocol)
FILEBASE_GATEWAYS=your-gateway.myfilebase.com
# Public gateway hostname used in links returned to clients
FILEBASE_PUBLIC_GATEWAY=your-public-gateway.myfilebase.com

# -----------------------------------------------------------------------------
# Pre-created buckets (seeded into MongoDB at startup)
# Each bucket must already exist in Filebase. Paid buckets 1..3 are optional;
# a bucket is only seeded when both NAME and RPC_TOKEN are set.
# -----------------------------------------------------------------------------
# Shared free-tier bucket
BUCKET_FREE_NAME=algofile-bucket-free
BUCKET_FREE_RPC_TOKEN=

BUCKET_1_NAME=
BUCKET_1_LIMIT_GB=10
BUCKET_1_RPC_TOKEN=

BUCKET_2_NAME=
BUCKET_2_LIMIT_GB=25
BUCKET_2_RPC_TOKEN=

BUCKET_3_NAME=
BUCKET_3_LIMIT_GB=50
BUCKET_3_RPC_TOKEN=
